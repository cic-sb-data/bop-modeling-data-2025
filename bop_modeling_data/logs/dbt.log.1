      "bop"."dev"."lkp__bil_charge_type_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__bil_crg_type_cd_id as (
        select bil_crg_type_cd
    from "bop"."dev"."raw__screngn__xcd_bil_cash_dsp"
    
    ), 

    cleaned__lkp__bil_crg_type_cd_id as ( 
        select
            coalesce(bil_crg_type_cd, '-9')
     as bil_crg_type_cd
    from base__lkp__bil_crg_type_cd_id 
    ),

    deduped__lkp__bil_crg_type_cd_id as (
        select distinct bil_crg_type_cd
    from cleaned__lkp__bil_crg_type_cd_id
    order by bil_crg_type_cd
    )

    select
        row_number() over (
            order by bil_crg_type_cd
        ) as bil_crg_type_id,
        bil_crg_type_cd,
        now() as generated_at

    from deduped__lkp__bil_crg_type_cd_id
),

renamed as (
    select
        bil_crg_type_id as bil_charge_type_id,
        bil_crg_type_cd as bil_charge_type_code,
        generated_at
    from lkp
),

add_desc as (
    select 
        bil_charge_type_id,
        bil_charge_type_code,
        case 
            when bil_charge_type_code='S' then 'Service'
            when bil_charge_type_code='P' then 'Penalty'
            when bil_charge_type_code='L' then 'Late fee'
            when bil_charge_type_code='D' then 'Down Payment fee'
            else 'Unknown Charge Type'
        end as bil_charge_type_desc,
        generated_at

    from renamed
)

select *
