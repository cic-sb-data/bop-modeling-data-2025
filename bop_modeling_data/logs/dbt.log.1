  create view "bop"."dev"."stg__screngn__xcd_bil_cash_receipt__dbt_tmp" as (
    -- depends_on: "bop"."dev"."lkp__bil_acct_key"

with

raw as (
    select 
        bil_account_id,
        * exclude(
            bil_account_id,
            bil_account_id_hash
        ) replace(
            try_cast(
            concat(
                right(try_cast(BIL_DTB_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(BIL_DTB_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(BIL_DTB_DT as varchar), 2)
            ) as date
        )
 as BIL_DTB_DT,
            try_cast(
            concat(
                right(try_cast(BIL_DEPOSIT_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(BIL_DEPOSIT_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(BIL_DEPOSIT_DT as varchar), 2)
            ) as date
        )
 as BIL_DEPOSIT_DT,
            try_cast(
            concat(
                right(try_cast(BIL_RCT_RECEIVE_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(BIL_RCT_RECEIVE_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(BIL_RCT_RECEIVE_DT as varchar), 2)
            ) as date
        )
 as BIL_RCT_RECEIVE_DT
        ) 

    from "bop"."dev"."raw__screngn__xcd_bil_cash_receipt"
)

select *
from raw
  );

