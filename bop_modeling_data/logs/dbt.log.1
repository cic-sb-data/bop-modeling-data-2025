  create view "bop"."dev_fct_billing"."04__join_policy_keys_to_policy_chains_and_calculate_date_cutoffs__dbt_tmp" as (
    -- This model joins policy keys to policy chains and calculates date cutoffs.

with

deduped as (
    select *
    from "bop"."dev_fct_billing"."03__deduplicated_policy_keys"
),

images as (
    select  
        sb_aiv_key,
        sb_policy_key,
        image_eff_date

    from "bop"."dev"."stg__decfile__sb_aiv_lookup"
),

chains as (
    select 
        sb_policy_key,
        policy_eff_date,
        policy_chain_id

    from "bop"."dev"."stg__decfile__sb_policy_lookup"
    where policy_chain_id is not null
),

joined as (
    select
        deduped.sb_aiv_key,
        deduped.sb_policy_key,
        images.image_eff_date,
        chains.policy_eff_date,
        chains.policy_chain_id,

        -- Claims evaluation and cutoff dates (SAS intnx logic)
        date_add(image_eff_date, interval '-4 MONTH') as clm_eval_date,

        date_add(date_add(image_eff_date, interval '-4 MONTH'), interval '-8 MONTH') as clm_prev_1yr_start,
        date_add(date_add(image_eff_date, interval '-4 MONTH'), interval '-20 MONTH') as clm_prev_2yr_start,
        date_add(date_add(image_eff_date, interval '-4 MONTH'), interval '-32 MONTH') as clm_prev_3yr_start,
        date_add(date_add(image_eff_date, interval '-4 MONTH'), interval '-44 MONTH') as clm_prev_4yr_start,
        date_add(date_add(image_eff_date, interval '-4 MONTH'), interval '-56 MONTH') as clm_prev_5yr_start,

        date_add(image_eff_date, interval '-4 MONTH') as clm_prev_1yr_end,
        date_add(date_add(image_eff_date, interval '-4 MONTH'), interval '-8 MONTH') as clm_prev_2yr_end,
        date_add(date_add(image_eff_date, interval '-4 MONTH'), interval '-20 MONTH') as clm_prev_3yr_end,
        date_add(date_add(image_eff_date, interval '-4 MONTH'), interval '-32 MONTH') as clm_prev_4yr_end,
        date_add(date_add(image_eff_date, interval '-4 MONTH'), interval '-44 MONTH') as clm_prev_5yr_end,

        -- Billing evaluation and cutoff dates (SAS intnx logic)
        date_add(image_eff_date, interval '-4 MONTH') as bil_eval_date,

        date_add(image_eff_date, interval '-1 YEAR') as bil_prev_1yr_start,
        date_add(image_eff_date, interval '-2 YEAR') as bil_prev_2yr_start,
        date_add(image_eff_date, interval '-3 YEAR') as bil_prev_3yr_start,
        date_add(image_eff_date, interval '-4 YEAR') as bil_prev_4yr_start,
        date_add(image_eff_date, interval '-5 YEAR') as bil_prev_5yr_start,

        date_add(image_eff_date, interval '-4 MONTH') as bil_prev_1yr_end,
        date_add(image_eff_date, interval '-1 YEAR')  as bil_prev_2yr_end,
        date_add(image_eff_date, interval '-2 YEAR')  as bil_prev_3yr_end,
        date_add(image_eff_date, interval '-3 YEAR')  as bil_prev_4yr_end,
        date_add(image_eff_date, interval '-4 YEAR')  as bil_prev_5yr_end

    from deduped
    left join images
        on deduped.sb_aiv_key = images.sb_aiv_key
    left join chains
        on deduped.sb_policy_key = chains.sb_policy_key
        and images.sb_policy_key = chains.sb_policy_key
)

select * from joined
  );

