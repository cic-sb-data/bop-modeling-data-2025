  create view "bop"."dev"."fct__exp_cr_score__dbt_tmp" as (
    with

selected_cols as (
    select
        associated_policy_key,
        date_of_data_dt,
        experian_bin,
        commercial_intelliscore,
        yearsinfile,
        alltrades,
        baltot,
        ballate_all_dbt,
        numtot_combined,
        baltot_combined,
        judgmentcount,
        liencount,
        bankruptcy_cnt,
        ttc038,
        ttc039

    from "bop"."dev"."stg__experian"
),


-- Note that the column names are maintained exactly as they were originally definined 
-- in prior models, but may not accurately reflect the data they contain, or the intent 
-- behind the particular variable.
bin_hit_vars as (
    select 
        *,
        case when experian_bin is null then 0 else 1 end as bin_hit,
        case when (1 <= commercial_intelliscore) and (commercial_intelliscore <= 100) then 1 else 0 end as exp_hit

    from selected_cols
),

positive_value_indicators_1 as (
    select
        *,case when alltrades > 0 then 1 else 0 end as alltrades_positive,
        case when baltot > 0 then 1 else 0 end as baltot_positive,
        case when numtot_combined > 0 then 1 else 0 end as numtot_combined_positive,
        case when baltot_combined > 0 then 1 else 0 end as baltot_combined_positive
        

    from bin_hit_vars
),

calculate_pay_sat as (
    select
        *,
        case when ttc038 = 0 or ttc038 is null then null else ttc039 / ttc038 end
 as pay_sat

    from positive_value_indicators_1
),

add_is_not_missing_vars as (
    select
        *,
        
            CASE WHEN CASE WHEN experian_bin IS NULL THEN 1
WHEN typeof(experian_bin) = 'null' THEN 1
WHEN typeof(experian_bin) = 'text' THEN CASE WHEN (lower(trim(try_cast(experian_bin as varchar))) = 'missing')
    OR (lower(trim(try_cast(experian_bin as varchar))) = 'n/a')
    OR (lower(trim(try_cast(experian_bin as varchar))) = 'na')
    OR (lower(trim(try_cast(experian_bin as varchar))) = '') THEN 1
ELSE 0 END
WHEN typeof(experian_bin) = 'numeric' THEN CASE WHEN (experian_bin IS NULL) OR (experian_bin = 0) THEN 1 ELSE 0 END
WHEN typeof(experian_bin) = 'date' THEN CASE WHEN experian_bin IS NULL THEN 1
    WHEN experian_bin = '0000-00-00' THEN 1
    WHEN experian_bin = '0001-01-01' THEN 1
    WHEN experian_bin = '9999-12-31' THEN 1
ELSE 0 END
WHEN typeof(experian_bin) = 'timestamp' THEN CASE WHEN experian_bin IS NULL THEN 1
    WHEN experian_bin = '0000-00-00 00:00:00' THEN 1
    WHEN experian_bin = '0001-01-01 00:00:00' THEN 1
    WHEN experian_bin = '9999-12-31 23:59:59' THEN 1
ELSE 0 END 
ELSE 0 END = 1 THEN 0 ELSE 1 END as experian_bin_source,
        
            CASE WHEN CASE WHEN baltot IS NULL THEN 1
WHEN typeof(baltot) = 'null' THEN 1
WHEN typeof(baltot) = 'text' THEN CASE WHEN (lower(trim(try_cast(baltot as varchar))) = 'missing')
    OR (lower(trim(try_cast(baltot as varchar))) = 'n/a')
    OR (lower(trim(try_cast(baltot as varchar))) = 'na')
    OR (lower(trim(try_cast(baltot as varchar))) = '') THEN 1
ELSE 0 END
WHEN typeof(baltot) = 'numeric' THEN CASE WHEN (baltot IS NULL) OR (baltot = 0) THEN 1 ELSE 0 END
WHEN typeof(baltot) = 'date' THEN CASE WHEN baltot IS NULL THEN 1
    WHEN baltot = '0000-00-00' THEN 1
    WHEN baltot = '0001-01-01' THEN 1
    WHEN baltot = '9999-12-31' THEN 1
ELSE 0 END
WHEN typeof(baltot) = 'timestamp' THEN CASE WHEN baltot IS NULL THEN 1
    WHEN baltot = '0000-00-00 00:00:00' THEN 1
    WHEN baltot = '0001-01-01 00:00:00' THEN 1
    WHEN baltot = '9999-12-31 23:59:59' THEN 1
ELSE 0 END 
ELSE 0 END = 1 THEN 0 ELSE 1 END as baltot_source,
        
            CASE WHEN CASE WHEN alltrades IS NULL THEN 1
WHEN typeof(alltrades) = 'null' THEN 1
WHEN typeof(alltrades) = 'text' THEN CASE WHEN (lower(trim(try_cast(alltrades as varchar))) = 'missing')
    OR (lower(trim(try_cast(alltrades as varchar))) = 'n/a')
    OR (lower(trim(try_cast(alltrades as varchar))) = 'na')
    OR (lower(trim(try_cast(alltrades as varchar))) = '') THEN 1
ELSE 0 END
WHEN typeof(alltrades) = 'numeric' THEN CASE WHEN (alltrades IS NULL) OR (alltrades = 0) THEN 1 ELSE 0 END
WHEN typeof(alltrades) = 'date' THEN CASE WHEN alltrades IS NULL THEN 1
    WHEN alltrades = '0000-00-00' THEN 1
    WHEN alltrades = '0001-01-01' THEN 1
    WHEN alltrades = '9999-12-31' THEN 1
ELSE 0 END
WHEN typeof(alltrades) = 'timestamp' THEN CASE WHEN alltrades IS NULL THEN 1
    WHEN alltrades = '0000-00-00 00:00:00' THEN 1
    WHEN alltrades = '0001-01-01 00:00:00' THEN 1
    WHEN alltrades = '9999-12-31 23:59:59' THEN 1
ELSE 0 END 
ELSE 0 END = 1 THEN 0 ELSE 1 END as alltrades_source,
        
            CASE WHEN CASE WHEN ballate_all_dbt IS NULL THEN 1
WHEN typeof(ballate_all_dbt) = 'null' THEN 1
WHEN typeof(ballate_all_dbt) = 'text' THEN CASE WHEN (lower(trim(try_cast(ballate_all_dbt as varchar))) = 'missing')
    OR (lower(trim(try_cast(ballate_all_dbt as varchar))) = 'n/a')
    OR (lower(trim(try_cast(ballate_all_dbt as varchar))) = 'na')
    OR (lower(trim(try_cast(ballate_all_dbt as varchar))) = '') THEN 1
ELSE 0 END
WHEN typeof(ballate_all_dbt) = 'numeric' THEN CASE WHEN (ballate_all_dbt IS NULL) OR (ballate_all_dbt = 0) THEN 1 ELSE 0 END
WHEN typeof(ballate_all_dbt) = 'date' THEN CASE WHEN ballate_all_dbt IS NULL THEN 1
    WHEN ballate_all_dbt = '0000-00-00' THEN 1
    WHEN ballate_all_dbt = '0001-01-01' THEN 1
    WHEN ballate_all_dbt = '9999-12-31' THEN 1
ELSE 0 END
WHEN typeof(ballate_all_dbt) = 'timestamp' THEN CASE WHEN ballate_all_dbt IS NULL THEN 1
    WHEN ballate_all_dbt = '0000-00-00 00:00:00' THEN 1
    WHEN ballate_all_dbt = '0001-01-01 00:00:00' THEN 1
    WHEN ballate_all_dbt = '9999-12-31 23:59:59' THEN 1
ELSE 0 END 
