  create view "bop"."dev"."stg__screngn__xcd_bil_act_summary__dbt_tmp" as (
    -- depends_on: "bop"."dev"."lkp__bil_acct_key"

with

raw as (select * from "bop"."dev"."raw__screngn__xcd_bil_act_summary"),
acct_key as (select * from "bop"."dev"."lkp__bil_acct_key"),
act_desc_key as (select * from "bop"."dev"."_xcd_act_desc_key"),
act_reason_key as (select * from "bop"."dev"."_xcd_act_reason_key"),
act_summary_key as (select * from "bop"."dev"."lkp__bil_act_summary_key"),

recode_and_renamed as (
    select
        BIL_ACCT_ID as bil_acct_id,
        POL_SYMBOL_CD as policy_sym,
        try_cast(POL_NBR as uinteger) as policy_numb,
        BIL_ACY_DES_CD as bil_act_desc_code,
        BIL_DES_REA_TYP as bil_act_reason_type_code,
        try_cast(
            concat(
                right(try_cast(BIL_ACY_DES1_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(BIL_ACY_DES1_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(BIL_ACY_DES1_DT as varchar), 2)
            ) as date
        )
 as bil_act_desc1_date,
        try_cast(
            concat(
                right(try_cast(BIL_ACY_DES2_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(BIL_ACY_DES2_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(BIL_ACY_DES2_DT as varchar), 2)
            ) as date
        )
 as bil_act_desc2_date,
        try_cast(BIL_ACY_AMT as double) as bil_act_amt,
        USER_ID as user_id,
        split(BIL_ACY_TS, ':')[1] as bil_act_time,
        BAS_ADD_DATA_TXT as bil_act_summary_addl_data,

        *

    from raw
),

add_acct_key as (
    with

    raw as (
        select *
        from "bop"."dev"."lkp__bil_acct_key"
    ),

    joined as (
        select 
            raw.bil_acct_key,
            to_tbl.*

        from recode_and_renamed as to_tbl
        left join raw
            on to_tbl.bil_acct_id = raw.bil_acct_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered),

joined as (
    select 
        act_summary_key.bil_act_summary_key,
        acct_key.bil_acct_key,
        act_desc_key.bil_act_desc_key,
        act_reason_key.bil_act_reason_key,
        acct_key.* exclude (bil_acct_key)
        
    from add_acct_key as acct_key
    left join act_summary_key
        on acct_key.bil_acct_id = acct_key.bil_acct_id
    left join act_desc_key
        on acct_key.bil_act_desc_code = act_desc_key.bil_act_desc_code 
    left join act_reason_key 
        on acct_key.bil_act_reason_type_code = act_reason_key.bil_act_reason_type_code
    
),

drop_join_cols as (
    select
        *

    from joined
)

select *
from add_acct_key
  );

