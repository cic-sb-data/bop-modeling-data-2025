      "bop"."dev"."lkp__bil_policy_issue_ind_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__bil_policy_issue_ind_id as (
        select bil_issue_ind, bil_policy_issue_ind_desc
    from "bop"."dev"."raw__screngn__xcd_bil_policy"
    
