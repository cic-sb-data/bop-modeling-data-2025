        row_number() over (
            order by bat_status_cd, bat_status_desc
        ) as bil_acct_status_id,
        bat_status_cd, bat_status_desc,
        now() as generated_at

    from deduped__lkp__bil_acct_status_id
),

renamed as (
    select 
        bil_acct_status_id,
        bat_status_cd as bil_acct_status_cd,
        bat_status_desc as bil_acct_status_desc,
        generated_at
    from lkp
)

