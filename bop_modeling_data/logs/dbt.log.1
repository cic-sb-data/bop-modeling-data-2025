    create  table
      "bop"."dev"."lkp__bil_plan_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__bil_plan_id as (
        select cur_bil_plan_cd, current_billing_plan
    from "bop"."dev"."raw__screngn__xcd_bil_policy"
    
    ), 

    cleaned__lkp__bil_plan_id as ( 
        select
            coalesce(cur_bil_plan_cd, '-9')
     as cur_bil_plan_cd,
            coalesce(current_billing_plan, '-9')
     as current_billing_plan
    from base__lkp__bil_plan_id 
    ),

    deduped__lkp__bil_plan_id as (
        select distinct cur_bil_plan_cd, current_billing_plan
    from cleaned__lkp__bil_plan_id
    order by cur_bil_plan_cd, current_billing_plan
    )

    select
        row_number() over (
            order by cur_bil_plan_cd, current_billing_plan
        ) as bil_plan_id,
        cur_bil_plan_cd, current_billing_plan,
        now() as generated_at

    from deduped__lkp__bil_plan_id
),

recoded as (
    select 
        bil_plan_id,
        cur_bil_plan_cd as bil_plan_cd,
        case
            when lower(cur_bil_plan_cd) like '%an%' then 'Annual'
            when lower(cur_bil_plan_cd) like '%mo%' then 'Monthly'
            when lower(cur_bil_plan_cd) like '%semi%' then 'Semi-Annual'
            when lower(cur_bil_plan_cd) like '%anpp%' then 'Annual Pre-Payment'
            when lower(cur_bil_plan_cd) like '%qt%' then 'Quarterly'
            when lower(cur_bil_plan_cd) like '%bi%' then 'Bi-Annual'
            when lower(cur_bil_plan_cd) like '%25su%' then '25% Surcharge'
            when lower(cur_bil_plan_cd) like '%anbd%' then 'Annual Budget'
            else 'Unknown'
        end as bil_plan_desc,
        generated_at
    from lkp
)


select *
from recoded
order by bil_plan_id
    );
  
  
