    create  table
      "bop"."dev"."lkp__bil_policy_term__dbt_tmp"
  
    as (
      with 

lkp as (
    
    
    
    with

    raw as (
        select distinct 
        
        
        BIL_ACCOUNT_ID as bil_acct_id,
        
        
        XCD_POLICY_ID as bil_policy_id,
        
        
        POL_NBR as policy_numb,
        
        
        POL_EFFECTIVE_DT as policy_eff_date
        from "bop"."dev"."raw__screngn__xcd_bil_policy_trm"
        order by 
        bil_acct_id,
        bil_policy_id,
        policy_numb,
        policy_eff_date
    ),

    add_key as (
        select 
            row_number() over() as bil_policy_trm_key,
            
        bil_acct_id,
        bil_policy_id,
        policy_numb,
        policy_eff_date
        from raw
    ),

    sort_table as (
        select *
        from add_key
        order by bil_policy_trm_key
    )

    select *
    from sort_table),
add_acct_key as (
    with

    raw as (
        select *
        from "bop"."dev"."lkp__bil_acct_key"
    ),

    joined as (
        select 
            raw.bil_acct_key,
            to_tbl.*

        from lkp as to_tbl
        left join raw
            on to_tbl.bil_acct_id = raw.bil_acct_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered),
add_policy_key as (with

    raw as (
        select *
        from "bop"."dev"."lkp__bil_policy_key"
    ),

    joined as (
        select 
            raw.bil_policy_key,
            to_tbl.*

        from add_acct_key as to_tbl
        left join raw
            on to_tbl.bil_policy_id = raw.bil_policy_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered),

recoded as (
    select
        bil_policy_trm_key,
        bil_policy_key,
        bil_acct_key,
        policy_sym,
        policy_numb,
        policy_eff_date,
        try_cast(
            concat(
                right(try_cast(policy_eff_date as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(policy_eff_date as varchar), 3, 3))
                ),
                '-',
                left(try_cast(policy_eff_date as varchar), 2)
            ) as date
        )
 as policy_eff_date

    from add_policy_key
)

select *
from recoded
order by bil_policy_trm_key
    );
  
  
