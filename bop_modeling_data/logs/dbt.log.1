    union all select 'BPA' as bil_desc_reason_cd, 'Payable item for audits' as bil_desc_reason_desc
    union all select 'BPS' as bil_desc_reason_cd, 'Payable item for taxes, fees, and surcharges' as bil_desc_reason_desc
