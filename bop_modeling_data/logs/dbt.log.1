    create  table
      "bop"."dev"."lkp__bil_desc_reason_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__bil_desc_reason_id as (
        select bdr_long_des, bil_des_rea_cd, bil_des_rea_des, bil_des_rea_typ
    from "bop"."dev"."raw__screngn__xcd_bil_des_reason"
    
    ), 

    cleaned__lkp__bil_desc_reason_id as ( 
        select
            coalesce(bdr_long_des, '-9')
     as bdr_long_des,
            coalesce(bil_des_rea_cd, '-9')
     as bil_des_rea_cd,
            coalesce(bil_des_rea_des, '-9')
     as bil_des_rea_des,
            coalesce(bil_des_rea_typ, '-9')
     as bil_des_rea_typ
    from base__lkp__bil_desc_reason_id 
    ),

    deduped__lkp__bil_desc_reason_id as (
        select distinct bdr_long_des, bil_des_rea_cd, bil_des_rea_des, bil_des_rea_typ
    from cleaned__lkp__bil_desc_reason_id
    order by bdr_long_des, bil_des_rea_cd, bil_des_rea_des, bil_des_rea_typ
    )

    select
        row_number() over (
            order by bdr_long_des, bil_des_rea_cd, bil_des_rea_des, bil_des_rea_typ
        ) as bil_desc_reason_id,
        bdr_long_des, bil_des_rea_cd, bil_des_rea_des, bil_des_rea_typ,
        now() as generated_at

    from deduped__lkp__bil_desc_reason_id
),

desc_lkp as (
    select ' ' as bil_desc_reason_cd, 'system defined activity' as bil_desc_reason_desc
    union all select 'ACH' as bil_desc_reason_cd, 'PACS payments' as bil_desc_reason_desc
    union all select 'AMT' as bil_desc_reason_cd, 'Amount types for payable items' as bil_desc_reason_desc
