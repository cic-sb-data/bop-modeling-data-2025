  create view "bop"."dev"."fct__associated_policy_eff_date__dbt_tmp" as (
    with

policies as (
    select 
        associated_policy_key,
        policy_eff_date
        
    from "bop"."dev"."lkp__associated_policies"
),

dates as (
    select 
        input_date as policy_eff_date,
        n_prior_years,
        prior_year_start,
        prior_year_end

    from "bop"."dev"."lkp__dates"
),

eff_date_lkp as (
