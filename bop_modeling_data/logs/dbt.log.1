    create  table
      "bop"."dev"."lkp__bil_receipt_type_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__bil_rct_type_cd_id as (
        select bil_rct_type_cd
    from "bop"."dev"."raw__screngn__xcd_bil_cash_receipt"
    
    ), 

    cleaned__lkp__bil_rct_type_cd_id as ( 
        select
            coalesce(bil_rct_type_cd, '-9')
     as bil_rct_type_cd
    from base__lkp__bil_rct_type_cd_id 
    ),

    deduped__lkp__bil_rct_type_cd_id as (
        select distinct bil_rct_type_cd
    from cleaned__lkp__bil_rct_type_cd_id
    order by bil_rct_type_cd
    )

