      "bop"."dev"."lkp__bil_acct_status_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__bil_acct_status_id as (
        select bat_status_cd, bat_status_desc
    from "bop"."dev"."raw__screngn__xcd_bil_account"
    
    ), 

    cleaned__lkp__bil_acct_status_id as ( 
        select
            coalesce(bat_status_cd, '-9')
