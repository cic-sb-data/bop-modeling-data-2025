[0m15:37:01.273479 [debug] [Thread-20 ]: On model.bop_modeling_data.lkp__bil_policy_trm_key: /* {"app": "dbt", "dbt_version": "1.10.2", "profile_name": "bop_modeling_db", "target_name": "dev", "node_id": "model.bop_modeling_data.lkp__bil_policy_trm_key"} */

  
    
    

    create  table
      "bop"."dev"."lkp__bil_policy_trm_key__dbt_tmp"
  
    as (
      with 

lkp as (
    
    
    
    with

    raw as (
        select distinct 
        
        
        BIL_ACCOUNT_ID as bil_acct_id,
        
        
        XCD_POLICY_ID as bil_policy_id,
        
        
        POL_EFFECTIVE_DT as policy_eff_date
        from "bop"."dev"."raw__screngn__xcd_bil_policy_trm"
        order by 
        bil_acct_id,
        bil_policy_id,
        policy_eff_date
    ),

    add_key as (
        select 
            row_number() over() as bil_policy_trm_key,
            
        bil_acct_id,
        bil_policy_id,
        policy_eff_date
        from raw
    ),

    sort_table as (
        select *
        from add_key
        order by bil_policy_trm_key
    )

    select *
    from sort_table),
add_acct_key as (
    with

    raw as (
        select *
        from "bop"."dev"."lkp__bil_acct_key"
    ),

    joined as (
        select 
            raw.bil_acct_key,
            to_tbl.*

        from lkp as to_tbl
        left join raw
            on to_tbl.bil_acct_id = raw.bil_acct_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered),

policy_key as (
    select
        bil_acct_key,
        bil_policy_key,
        bil_policy_id,
        policy_eff_date

    from "bop"."dev"."lkp__bil_policy_key"
    where bil_policy_key is not null
),

recoded as (
    select
        bil_policy_trm_key,
        bil_policy_id,
        bil_acct_key,
        try_cast(
            concat(
                right(try_cast(policy_eff_date as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(policy_eff_date as varchar), 3, 3))
                ),
                '-',
                left(try_cast(policy_eff_date as varchar), 2)
            ) as date
        )
 as policy_eff_date

    from add_acct_key
),

join_policy_key as (
    select
        a.bil_policy_trm_key,
        b.bil_acct_key,
        b.bil_policy_key,
        a.policy_eff_date

    from recoded a
    left join policy_key b
        on a.bil_policy_id = b.bil_policy_id
        and a.policy_eff_date = b.policy_eff_date
        and a.bil_acct_key = b.bil_acct_key
),

add_row_count_before as (
    select count(*) as row_count_before 
    from join_policy_key
),

add_row_count_after as (
    select count(*) as row_count_after 
    from join_policy_key
    where bil_policy_key is not null
),

add_in_both_row_counts as (
    select
        joined.*,
        before.row_count_before,
        after.row_count_after
    from join_policy_key joined
    left join add_row_count_before before
        on 1=1
    left join add_row_count_after after
        on 1=1
    
    where   
        joined.bil_policy_key is not null
        and joined.policy_eff_date is not null
        and joined.bil_acct_key is not null
)

select *
from add_in_both_row_counts
order by bil_policy_trm_key
    );
  
  
