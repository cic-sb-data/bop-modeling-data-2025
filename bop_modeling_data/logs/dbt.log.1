    create  table
      "bop"."dev"."lkp__bil_acct_cash_status_id__dbt_tmp"
  
    as (
      with
lkp as (
    with 

    base__lkp__bat_cash_status_cd_id as (
        select bat_cash_status_cd
    from "bop"."dev"."raw__screngn__xcd_bil_account"
    
    ), 

    cleaned__lkp__bat_cash_status_cd_id as ( 
        select
            coalesce(bat_cash_status_cd, '-9')
     as bat_cash_status_cd
    from base__lkp__bat_cash_status_cd_id 
    ),

    deduped__lkp__bat_cash_status_cd_id as (
        select distinct bat_cash_status_cd
    from cleaned__lkp__bat_cash_status_cd_id
    order by bat_cash_status_cd
    )

    select
        row_number() over (
            order by bat_cash_status_cd
        ) as bat_cash_status_id,
        bat_cash_status_cd,
        now() as generated_at

    from deduped__lkp__bat_cash_status_cd_id
),

add_desc as (
    select
        *,
        case
            when bat_cash_status_cd = 'A' then 'Active'
            when bat_cash_status_cd = 'D' then 'Suspended/Hold Auto Disbursement'
            else 'Unknown Code'
        end as bat_cash_status_desc
        
    from lkp
),

renamed as (
    select
        bat_cash_status_id as bil_acct_cash_status_id,
        bat_cash_status_cd as bil_acct_cash_status_cd,
        bat_cash_status_desc as bil_acct_cash_status_desc,
        generated_at
    from add_desc
)

select *
from renamed
order by bil_acct_cash_status_id
    );
  
  
