    create  table
      "bop"."dev"."lkp__bil_collection_method_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__bil_collection_method_id as (
        select bil_collection_method_desc, bil_collection_mth
    from "bop"."dev"."raw__screngn__xcd_bil_account"
    
    ), 

    cleaned__lkp__bil_collection_method_id as ( 
        select
            coalesce(bil_collection_method_desc, '-9')
     as bil_collection_method_desc,
            coalesce(bil_collection_mth, '-9')
     as bil_collection_mth
    from base__lkp__bil_collection_method_id 
    ),

    deduped__lkp__bil_collection_method_id as (
        select distinct bil_collection_method_desc, bil_collection_mth
    from cleaned__lkp__bil_collection_method_id
    order by bil_collection_method_desc, bil_collection_mth
    )

    select
        row_number() over (
            order by bil_collection_method_desc, bil_collection_mth
        ) as bil_collection_method_id,
        bil_collection_method_desc, bil_collection_mth,
        now() as generated_at

    from deduped__lkp__bil_collection_method_id
),

renamed as (
    select
        bil_collection_method_id,
        bil_collection_mth as bil_collection_method,
        bil_collection_method_desc,
        generated_at
    from lkp
)

select *
from renamed
    );
  
  
