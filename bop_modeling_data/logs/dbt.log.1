    from lkp
),

join_desc as (
    select
        r.bil_cash_entry_method_id,
        r.bil_cash_entry_method_cd,
        d.bil_cash_entry_method_desc,
        r.generated_at
    from renamed r
    left join add_desc d    
        on r.bil_cash_entry_method_cd = d.bil_cash_entry_method_cd
)

