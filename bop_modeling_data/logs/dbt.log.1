    create  table
      "bop"."dev"."lkp__bil_dsp_reason_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__bil_dsp_reason_cd_id as (
        select bil_dsp_reason_cd
    from "bop"."dev"."raw__screngn__xcd_bil_cash_dsp"
    
    ), 

    cleaned__lkp__bil_dsp_reason_cd_id as ( 
        select
            coalesce(bil_dsp_reason_cd, '-9')
     as bil_dsp_reason_cd
    from base__lkp__bil_dsp_reason_cd_id 
    ),

    deduped__lkp__bil_dsp_reason_cd_id as (
        select distinct bil_dsp_reason_cd
    from cleaned__lkp__bil_dsp_reason_cd_id
    order by bil_dsp_reason_cd
    )

    select
        row_number() over (
            order by bil_dsp_reason_cd
        ) as bil_dsp_reason_id,
        bil_dsp_reason_cd,
        now() as generated_at

    from deduped__lkp__bil_dsp_reason_cd_id
),

renamed as (
    select
        bil_dsp_reason_id,
        bil_dsp_reason_cd,
        generated_at
    from lkp
)

select *
from renamed
    );
  
  
