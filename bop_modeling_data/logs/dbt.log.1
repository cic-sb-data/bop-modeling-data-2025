impute_missing_with_0 as (
    select
        *,
        
            coalesce(judgmentcount,0)
 as judgmentcount_2,
        
            coalesce(liencount,0)
 as liencount_2,
        
            coalesce(bankruptcy_cnt,0)
 as bankruptcy_cnt_2
        from add_is_not_missing_vars
),

other_imputed_values as (
    select
        *,
		
        coalesce(ballate_all_dbt,0.0071)
 as ballate_all_dbt_2,
		
        coalesce(pay_sat,0.9444)
 as pay_sat_2,
		
        coalesce(experian_bin,0)
 as bin_2,
		
        coalesce(baltot,0)
 as baltot_2,
		
        coalesce(alltrades,0)
 as alltrades_2,
		
		
        
		
        coalesce(commercial_intelliscore,0.5)
 as commercial_intelliscore_2,
		
        coalesce(yearsinfile,0)
 as yearsinfile_2

    from impute_missing_with_0

),

capped_baltot_combined as ( with 

normalize_by_years_in_file as (
    select *, 
case when yearsinfile_2 < 1 then baltot_combined else baltot_combined / yearsinfile_2 end
 as baltot_combined_y
    from other_imputed_values
), 

impute_missing_values as (
    select *, coalesce(baltot_combined_y,127.78)
 as baltot_combined_y_2,
    from normalize_by_years_in_file
), 

in_thousands as (
    select *, baltot_combined_y_2 / 1000 as baltotk_combined_y_2
    from impute_missing_values
), 

capped as (
    select *, min(baltotk_combined_y_2, 10) as baltotk_combined_y_2_cap10
    from in_thousands
)

select * from capped ),
capped_numtot_combined as ( 
with

imputed_missing_values as (
    select *, coalesce(numtot_combined,5)
 as numtot_combined_2
    from capped_baltot_combined 
),

capped as (
    select *, min(numtot_combined_2, 10) as numtot_combined_2_cap10
    from imputed_missing_values
)

select  *
from capped
 ),

positive_value_indicators_2 as (
    select
        *,
        
        
            case when judgmentcount_2 > 0 then 1 else 0 end as judgmentcount_2_2_yn,
        
            case when liencount_2 > 0 then 1 else 0 end as liencount_2_2_yn,
        
            case when bankruptcy_cnt_2 > 0 then 1 else 0 end as bankruptcy_cnt_2_2_yn
        

    from capped_numtot_combined
),

calculate_log_model_score as (
    select
        *,
        case 
            when bin_hit = 0 
                then null
            else  0.2856 * alltrades_positive
                - 0.2987 * alltrades_positive * pay_sat_2
                + 0.0588 * baltot_positive
                + 0.0724 * baltot_positive * ballate_all_dbt_2
                - 0.0216 * numtot_combined_positive * numtot_combined_2_cap10
                + 0.0116 * baltot_combined_positive * baltotk_combined_y_2_cap10
                + 0.2204 * judgmentcount_2_yn
                + 0.1311 * liencount_2_yn
                + 0.1514 * bankruptcy_cnt_2_yn
        end as log_credit_score

    from positive_value_indicators_2
),

imputed_missing_log_credit_score as (
    select
        *,
        coalesce(log_credit_score,0)
 as log_credit_score_2

    from calculate_log_model_score
),

missing_log_credit_score_col as (
    select
        *,
        CASE WHEN CASE WHEN log_credit_score IS NULL THEN 1
WHEN typeof(log_credit_score) = 'null' THEN 1
WHEN typeof(log_credit_score) = 'text' THEN CASE WHEN (lower(trim(try_cast(log_credit_score as varchar))) = 'missing')
    OR (lower(trim(try_cast(log_credit_score as varchar))) = 'n/a')
    OR (lower(trim(try_cast(log_credit_score as varchar))) = 'na')
    OR (lower(trim(try_cast(log_credit_score as varchar))) = '') THEN 1
ELSE 0 END
WHEN typeof(log_credit_score) = 'numeric' THEN CASE WHEN (log_credit_score IS NULL) OR (log_credit_score = 0) THEN 1 ELSE 0 END
WHEN typeof(log_credit_score) = 'date' THEN CASE WHEN log_credit_score IS NULL THEN 1
    WHEN log_credit_score = '0000-00-00' THEN 1
    WHEN log_credit_score = '0001-01-01' THEN 1
    WHEN log_credit_score = '9999-12-31' THEN 1
ELSE 0 END
WHEN typeof(log_credit_score) = 'timestamp' THEN CASE WHEN log_credit_score IS NULL THEN 1
    WHEN log_credit_score = '0000-00-00 00:00:00' THEN 1
    WHEN log_credit_score = '0001-01-01 00:00:00' THEN 1
    WHEN log_credit_score = '9999-12-31 23:59:59' THEN 1
ELSE 0 END 
ELSE 0 END = 1 THEN 0 ELSE 1 END as log_credit_score_source

    from imputed_missing_log_credit_score
),

final as (
    select  
        associated_policy_key,
        log_credit_score_2 as log__expcr_score,
        log_credit_score_source as is_log__expcr_score_missing

    from missing_log_credit_score_col
)

select * from final
  );

