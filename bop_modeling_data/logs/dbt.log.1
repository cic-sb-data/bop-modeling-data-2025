    create  table
      "bop"."dev"."lkp__bil_plan_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__bil_plan_id as (
        select cur_bil_plan_cd, current_billing_plan
    from "bop"."dev"."raw__screngn__xcd_bil_policy"
    
    ), 

    cleaned__lkp__bil_plan_id as ( 
        select
            coalesce(cur_bil_plan_cd, '-9')
     as cur_bil_plan_cd,
            coalesce(current_billing_plan, '-9')
     as current_billing_plan
    from base__lkp__bil_plan_id 
    ),

    deduped__lkp__bil_plan_id as (
        select distinct cur_bil_plan_cd, current_billing_plan
    from cleaned__lkp__bil_plan_id
