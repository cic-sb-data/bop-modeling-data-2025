    from lkp
),

join_desc as (
    select
        r.bil_receipt_type_id,
        r.bil_receipt_type_cd,
        d.bil_receipt_type_desc,
        r.generated_at
    from renamed r
    left join desc_lkp d 
        on r.bil_receipt_type_cd = d.bil_receipt_type_cd
    order by r.bil_receipt_type_id
)

select *
from join_desc
    );
  
  
