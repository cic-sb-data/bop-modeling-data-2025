  create view "bop"."dev"."stg__screngn__xcd_bil_cash_dsp__dbt_tmp" as (
    -- depends_on: "bop"."dev"."lkp__bil_acct_key"

with

raw as (
    select 
        bil_account_id as bil_acct_id,
        XCD_POLICY_ID as billing_policy_id,
        bil_account_id_hash,
        * exclude(
            bil_account_id,
            bil_account_id_hash
        ) replace (
            try_cast(bil_dtb_dt as date) as BIL_DTB_DT,
            try_cast(POL_NBR as ubigint) as POL_NBR,
            try_cast(
            concat(
                right(try_cast(POL_EFFECTIVE_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(POL_EFFECTIVE_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(POL_EFFECTIVE_DT as varchar), 2)
            ) as date
        )
 as POL_EFFECTIVE_DT,
            try_cast(
            concat(
                right(try_cast(BIL_ADJ_DUE_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(BIL_ADJ_DUE_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(BIL_ADJ_DUE_DT as varchar), 2)
            ) as date
