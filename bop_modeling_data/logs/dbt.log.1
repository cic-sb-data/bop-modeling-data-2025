    create  table
      "bop"."dev"."lkp__bil_cash_dsp_key__dbt_tmp"
  
    as (
      with 

lkp as (
    
    
    
    with

    raw as (
        select distinct 
        
        
        BIL_ACCOUNT_ID as bil_acct_id,
        
        
        BIL_DTB_DT as bil_distribution_date,
        
        
        BIL_DTB_SEQ_NBR as bil_distribution_seq_numb,
        
        
        BIL_DSP_SEQ_NBR as bil_disposition_seq_numb
        from "bop"."dev"."raw__screngn__xcd_bil_cash_dsp"
        order by 
        bil_acct_id,
        bil_distribution_date,
        bil_distribution_seq_numb,
        bil_disposition_seq_numb
    ),

    add_key as (
        select 
            row_number() over() as bil_cash_dsp_key,
            
        bil_acct_id,
        bil_distribution_date,
        bil_distribution_seq_numb,
        bil_disposition_seq_numb
        from raw
    ),

    sort_table as (
        select *
        from add_key
        order by bil_cash_dsp_key
    )

    select *
    from sort_table),
add_acct_key as (
    with

    raw as (
        select *
        from "bop"."dev"."lkp__bil_acct_key"
    ),

    joined as (
        select 
            raw.bil_acct_key,
            to_tbl.*

        from lkp as to_tbl
        left join raw
            on to_tbl.bil_acct_id = raw.bil_acct_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered),

recoded as (
    select
        bil_cash_dsp_key,
        bil_acct_key,
        try_cast(
            concat(
                right(try_cast(bil_distribution_date as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(bil_distribution_date as varchar), 3, 3))
                ),
                '-',
                left(try_cast(bil_distribution_date as varchar), 2)
            ) as date
        )
 as bil_distribution_date,
        try_cast(bil_distribution_seq_numb as uinteger) as bil_distribution_seq_numb,
        try_cast(bil_disposition_seq_numb as uinteger) as bil_disposition_seq_numb
    from add_acct_key
)

select *
from recoded
order by bil_cash_dsp_key
    );
  
  
