    create  table
      "bop"."dev"."lkp__bil_payment_type_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__payment_type_id as (
        select payment_type
    from "bop"."dev"."raw__screngn__xcd_bil_cash_receipt"
    
    ), 

    cleaned__lkp__payment_type_id as ( 
        select
            coalesce(payment_type, '-9')
     as payment_type
    from base__lkp__payment_type_id 
    ),

    deduped__lkp__payment_type_id as (
        select distinct payment_type
    from cleaned__lkp__payment_type_id
    order by payment_type
    )

    select
        row_number() over (
            order by payment_type
        ) as payment_type_id,
        payment_type,
        now() as generated_at

    from deduped__lkp__payment_type_id
),

renamed as (
    select
        payment_type_id as bil_payment_type_id,
        payment_type as bil_payment_type,
        generated_at
    from lkp
)

select *
from renamed
    );
  
  
