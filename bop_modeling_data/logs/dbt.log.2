    create  table
      "bop"."dev"."xcd_bil_ist_schedule_key__dbt_tmp"
  
    as (
      with 

lkp as (
    
    
    
    with

    raw as (
        select distinct 
        
        
        BIL_ACCOUNT_ID as bil_acct_id,
        
        
        XCD_POLICY_ID as bil_policy_id,
        
        
        BIL_SEQ_NBR as bil_seq_numb
