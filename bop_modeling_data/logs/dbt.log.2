    create  table
      "bop"."dev"."lkp__bil_policy_issue_ind_id__dbt_tmp"
  
    as (
      with

lkp as (
    with 

    base__lkp__bil_policy_issue_ind_id as (
        select bil_issue_ind, bil_policy_issue_ind_desc
    from "bop"."dev"."raw__screngn__xcd_bil_policy"
    
    ), 

    cleaned__lkp__bil_policy_issue_ind_id as ( 
        select
            coalesce(bil_issue_ind, '-9')
     as bil_issue_ind,
            coalesce(bil_policy_issue_ind_desc, '-9')
     as bil_policy_issue_ind_desc
    from base__lkp__bil_policy_issue_ind_id 
    ),

    deduped__lkp__bil_policy_issue_ind_id as (
        select distinct bil_issue_ind, bil_policy_issue_ind_desc
    from cleaned__lkp__bil_policy_issue_ind_id
    order by bil_issue_ind, bil_policy_issue_ind_desc
    )

    select
        row_number() over (
            order by bil_issue_ind, bil_policy_issue_ind_desc
        ) as bil_policy_issue_ind_id,
        bil_issue_ind, bil_policy_issue_ind_desc,
        now() as generated_at

    from deduped__lkp__bil_policy_issue_ind_id
),

recoded as (
    select 
        bil_policy_issue_ind_id,
        bil_issue_ind as bil_policy_issue_ind_cd,
        bil_policy_issue_ind_desc as bil_policy_issue_ind_desc,
        generated_at
    from lkp
)


select *
from recoded
order by bil_policy_issue_ind_id
    );
  
  
