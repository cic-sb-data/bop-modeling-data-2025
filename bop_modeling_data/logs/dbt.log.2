    create  table
      "bop"."dev_test_failures"."dbt_expectations_expect_table__e3d4606ffba5b155593b792a5a585c0e"
  
    as (
      
    
  
    with a as (
        
    select
        
        count(*) as expression
    from
        "bop"."dev"."stg__decfile__sb_policy_lookup"
    

    ),
    b as (
        
    select
        
        count(*) * 1 as expression
    from
        "bop"."dev"."raw__decfile__sb_policy_lookup"
    

    ),
    final as (

        select
            
            a.expression,
            b.expression as compare_expression,
            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0)) as expression_difference,
            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0))/
                nullif(a.expression * 1.0, 0) as expression_difference_percent
        from
        
            a cross join b
        
    )
    -- DEBUG:
    -- select * from final
    select
        *
    from final
    where
        
        expression_difference > 0.0
        

  
  
    );
  
  
    
