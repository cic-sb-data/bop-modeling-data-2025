    create  table
      "bop"."dev_test_failures"."dbt_expectations_expect_column_f4e51d40e0accae74e5ca4be396bf90e"
  
    as (
      
    
  

with all_values as (

    select
        BIL_REVS_RSUS_IND as value_field

