        bil_policy_key,
        bil_policy_id

    from "bop"."dev"."xcd_bil_policy_key"
),

recoded as (
    select
        bil_ist_schedule_key,
        bil_policy_id,
        bil_acct_key,
        try_cast(bil_seq_numb as uinteger) as bil_seq_numb 

    from add_acct_key
),

joined as (
    select
        a.bil_ist_schedule_key,
        b.bil_acct_key,
        b.bil_policy_key,
        a.bil_seq_numb

    from recoded a
    left join policy_key b
        on a.bil_policy_id = b.bil_policy_id
        and a.bil_acct_key = b.bil_acct_key
)

select *
from recoded
where bil_seq_numb is not null
order by bil_ist_schedule_key
    );
  
  
