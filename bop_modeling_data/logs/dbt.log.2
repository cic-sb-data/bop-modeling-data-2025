    create  table
      "bop"."dev"."lkp__bil_type_id__dbt_tmp"
  
    as (
      with 

    base__lkp__bil_type_id as (
        select bil_type_cd, bil_type_desc
    from "bop"."dev"."raw__screngn__xcd_bil_account"
    
    ), 

    cleaned__lkp__bil_type_id as ( 
        select
            coalesce(bil_type_cd, '-9')
