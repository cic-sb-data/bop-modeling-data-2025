        select 
            raw.bil_acct_key,
            to_tbl.*

        from lkp as to_tbl
        left join raw
            on to_tbl.bil_acct_id = raw.bil_acct_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered),

policy_key as (
