    create  table
      "bop"."dev"."lkp__bil_type_id__dbt_tmp"
  
    as (
      with 

    base__lkp__bil_type_id as (
        select bil_type_cd, bil_type_desc
    from "bop"."dev"."raw__screngn__xcd_bil_account"
    
    ), 

    cleaned__lkp__bil_type_id as ( 
        select
            coalesce(bil_type_cd, '-9')
     as bil_type_cd,
            coalesce(bil_type_desc, '-9')
     as bil_type_desc
    from base__lkp__bil_type_id 
    ),

    deduped__lkp__bil_type_id as (
        select distinct bil_type_cd, bil_type_desc
    from cleaned__lkp__bil_type_id
    order by bil_type_cd, bil_type_desc
    )

    select
        row_number() over (
            order by bil_type_cd, bil_type_desc
        ) as bil_type_id,
        bil_type_cd, bil_type_desc,
        now() as generated_at

    from deduped__lkp__bil_type_id
