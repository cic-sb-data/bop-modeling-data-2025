    from "bop"."dev"."raw__screngn__xcd_bil_policy_trm"
),

policy as (
    select distinct
        bil_acct_id,
        bil_policy_id,
        policy_sym,
        policy_numb

    from "bop"."dev"."stg__screngn__xcd_bil_policy"
    where bil_policy_id is not null
),

join_policy_id as (
    select
        raw.*,
        policy.policy_sym,
        policy.policy_numb

    from raw
    left join policy
        on raw.bil_policy_id = policy.bil_policy_id
        and raw.bil_acct_id = policy.bil_acct_id

),

add_acct_key as (
    with

    raw as (
        select *
        from "bop"."dev"."xcd_bil_acct_key"
    ),

    joined as (
        select 
            raw.bil_acct_key,
            to_tbl.*

        from join_policy_id as to_tbl
        left join raw
            on to_tbl.bil_acct_id = raw.bil_acct_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered),


add_id as (
    select 
        row_number() over (
            order by 
                bil_acct_key, 
                bil_policy_id, 
                policy_sym, 
                policy_numb
        ) as bil_policy_key, 
        * 

    from add_acct_key
)


select *
from add_acct_key

  );

