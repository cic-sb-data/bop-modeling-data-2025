                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(bil_distribution_date as varchar), 3, 3))
                ),
                '-',
                left(try_cast(bil_distribution_date as varchar), 2)
            ) as date
        )
 as bil_distribution_date,
        try_cast(bil_distribution_seq_numb as uinteger) as bil_distribution_seq_numb
    from add_acct_key
)

select *
from recoded
order by bil_cash_receipt_key
    );
  
  
