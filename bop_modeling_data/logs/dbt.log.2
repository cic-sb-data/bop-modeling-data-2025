    create  table
      "bop"."dev"."lkp__bil_policy_key__dbt_tmp"
  
    as (
      with 

lkp as (
    
    
    
    with

    raw as (
        select distinct 
        
        
        BIL_ACCOUNT_ID as bil_acct_id,
        
        
        XCD_POLICY_ID as bil_policy_id
        from "bop"."dev"."raw__screngn__xcd_bil_policy"
        order by 
        bil_acct_id,
        bil_policy_id
    ),

    add_key as (
        select 
            row_number() over() as bil_policy_key,
            
        bil_acct_id,
        bil_policy_id
        from raw
    ),

    sort_table as (
        select *
        from add_key
        order by bil_policy_key
    )

    select *
    from sort_table),
add_acct_key as (
    with

    raw as (
        select *
        from "bop"."dev"."lkp__bil_acct_key"
    ),

    joined as (
        select 
            raw.bil_acct_key,
            to_tbl.*

        from lkp as to_tbl
        left join raw
            on to_tbl.bil_acct_id = raw.bil_acct_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered),

recoded as (
    select
        bil_policy_key,
        bil_acct_key,
        bil_policy_id
    from add_acct_key
)

select *
from recoded
order by bil_policy_key
    );
  
  
