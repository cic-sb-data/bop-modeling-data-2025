    deduped__lkp__bil_type_id as (
        select distinct bil_type_cd, bil_type_desc
    from cleaned__lkp__bil_type_id
    order by bil_type_cd, bil_type_desc
    )

    select
        row_number() over (
            order by bil_type_cd, bil_type_desc
        ) as bil_type_id,
        bil_type_cd, bil_type_desc,
        now() as generated_at

    from deduped__lkp__bil_type_id
    );
  
  
