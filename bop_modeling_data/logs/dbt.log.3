    create  table
      "bop"."dev_test_failures"."dbt_expectations_expect_table__82c2e4658931013ff800525bff3c536e"
  
    as (
      
    
  
    with a as (
        
    select
        
        count(*) as expression
    from
        "bop"."dev"."stg__screngn__xcd_bil_des_reason"
    

    ),
    b as (
        
    select
        
        count(*) * 1 as expression
