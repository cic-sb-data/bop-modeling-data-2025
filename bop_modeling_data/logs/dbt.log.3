        bat_cash_status_id as bil_acct_cash_status_id,
        bat_cash_status_cd as bil_acct_cash_status_cd,
        bat_cash_status_desc as bil_acct_cash_status_desc,
        generated_at
    from add_desc
)

select *
from renamed
order by bil_acct_cash_status_id
    );
  
  
