[0m11:50:54.018532 [debug] [Thread-1 (]: On model.bop_modeling_data.xcd_bil_act_summary_key: /* {"app": "dbt", "dbt_version": "1.10.2", "profile_name": "bop_modeling_db", "target_name": "dev", "node_id": "model.bop_modeling_data.xcd_bil_act_summary_key"} */

  
    
    

    create  table
      "bop"."dev"."xcd_bil_act_summary_key__dbt_tmp"
  
    as (
      with 

lkp as (
    
    
    
    with

    raw as (
        select distinct 
        
        
        BIL_ACCOUNT_ID as bil_acct_id,
        
        
        BIL_ACY_DT as bil_act_date,
        
        
        BIL_ACY_SEQ as bil_act_seq_numb
        from "bop"."dev"."raw__screngn__xcd_bil_act_summary"
        order by 
        bil_acct_id,
        bil_act_date,
        bil_act_seq_numb
    ),

    add_key as (
        select 
            row_number() over() as bil_act_summary_key,
            
        bil_acct_id,
        bil_act_date,
        bil_act_seq_numb
        from raw
    ),

    sort_table as (
        select *
        from add_key
        order by bil_act_summary_key
    )

    select *
    from sort_table),
add_acct_key as (
    with

    raw as (
        select *
        from "bop"."dev"."xcd_bil_acct_key"
    ),

    joined as (
        select 
            raw.bil_acct_key,
            to_tbl.*

        from lkp as to_tbl
        left join raw
            on to_tbl.bil_acct_id = raw.bil_acct_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered),

recoded as (
    select
        bil_act_summary_key,
        bil_acct_key,
        try_cast(
            concat(
                right(try_cast(bil_act_date as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(bil_act_date as varchar), 3, 3))
                ),
                '-',
                left(try_cast(bil_act_date as varchar), 2)
            ) as date
        )
 as bil_act_date,
        try_cast(bil_act_seq_numb as uinteger) as bil_act_seq_numb
    from add_acct_key
)

select *
from recoded
order by bil_act_summary_key
    );
  
  
