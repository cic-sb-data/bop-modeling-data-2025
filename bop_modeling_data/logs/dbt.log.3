    select 
        row_number() over (
            order by 
                bil_acct_key, 
                bil_policy_id, 
                policy_sym, 
                policy_numb
        ) as bil_policy_key, 
        * 

    from add_acct_key
)


select *
from add_id
order by bil_policy_key
  );

