  create view "bop"."dev"."stg__screngn__xcd_bil_cash_dsp__dbt_tmp" as (
    -- depends_on: "bop"."dev"."xcd_bil_acct_key"

with

raw as (
    select 
        bil_account_id as billing_acct_id,
        XCD_POLICY_ID as billing_policy_id,
        bil_account_id_hash,
        * exclude(
            bil_account_id,
            bil_account_id_hash
        ) replace (
            try_cast(bil_dtb_dt as date) as BIL_DTB_DT,
            try_cast(POL_NBR as ubigint) as POL_NBR,
            try_cast(
            concat(
                right(try_cast(POL_EFFECTIVE_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(POL_EFFECTIVE_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(POL_EFFECTIVE_DT as varchar), 2)
            ) as date
        )
 as POL_EFFECTIVE_DT,
            try_cast(
            concat(
                right(try_cast(BIL_ADJ_DUE_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(BIL_ADJ_DUE_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(BIL_ADJ_DUE_DT as varchar), 2)
            ) as date
        )
 as BIL_ADJ_DUE_DT,
            try_cast(
            concat(
                right(try_cast(BIL_INV_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(BIL_INV_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(BIL_INV_DT as varchar), 2)
            ) as date
        )
 as BIL_INV_DT,
            try_cast(
            concat(
                right(try_cast(BIL_DSP_DT as varchar), 4),
                '-',
                list_position(
                    ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
                    upper(substring(try_cast(BIL_DSP_DT as varchar), 3, 3))
                ),
                '-',
                left(try_cast(BIL_DSP_DT as varchar), 2)
            ) as date
        )
 as BIL_DSP_DT
        )

    from "bop"."dev"."raw__screngn__xcd_bil_cash_dsp"
),

add_acct_key as (
    with

    raw as (
        select *
        from "bop"."dev"."xcd_bil_acct_key"
    ),

    joined as (
        select 
            raw.bil_acct_key,
            to_tbl.*

        from raw as to_tbl
        left join raw
            on to_tbl.bil_acct_id = raw.bil_acct_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered),
add_policy_key as (with

    raw as (
        select *
        from "bop"."dev"."xcd_bil_policy_key"
    ),

    joined as (
        select 
            raw.bil_policy_key,
            to_tbl.*

        from raw as to_tbl
        left join raw
            on to_tbl.bil_policy_id = raw.bil_policy_id
    ),

    reordered as (
        select *
        from joined 
    )

    select *
    from reordered)

select *
from add_policy_key
  );

