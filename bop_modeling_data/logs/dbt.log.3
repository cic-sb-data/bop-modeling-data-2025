    create  table
      "bop"."dev_test_failures"."dbt_expectations_expect_table__68e645cee779cd0bea9fca3b408705e3"
  
    as (
      
    with a as (
        
    select
        
        count(*) as expression
    from
        "bop"."dev"."stg__screngn__xcd_bil_cash_receipt"
    

    ),
    b as (
        
    select
        
        count(*) * 1 as expression
    from
        "bop"."dev"."raw__screngn__xcd_bil_cash_receipt"
    

    ),
    final as (

        select
            
            a.expression,
            b.expression as compare_expression,
            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0)) as expression_difference,
            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0))/
                nullif(a.expression * 1.0, 0) as expression_difference_percent
        from
        
            a cross join b
        
    )
    -- DEBUG:
    -- select * from final
    select
        *
    from final
    where
        
        expression_difference > 0.0
        

    );
  
  
    
